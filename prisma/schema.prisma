generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model User {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(GURU)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  accounts      Account[]
  guru          Guru?
  posts         Post[]
  sessions      Session[]
   logs      UserLog[] 
  siswa         Siswa?

  @@map("users")
}

model Guru {
  id                 String      @id @default(uuid())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  namaLengkap        String
  nip                String?     @unique
  nik                String?     @unique
  tempatLahir        String?
  tanggalLahir       DateTime?
  jenisKelamin       Gender?
  agama              Agama?
  statusKawin        StatusKawin?
  noHp               String?
  emailAlternatif    String?
  alamatLengkap      String?
  kelurahan          String?
  kecamatan          String?
  kabupatenKota      String?
  provinsi           String?
  kodePos            String?
  pendidikanTerakhir String?
  jurusan            String?
  tahunLulus         Int?
  institusi          String?
  statusKepegawaian  String?
  golongan           String?
  pangkat            String?
  tmt                DateTime?
  masaKerja          Int?
  bidangStudi        String?
  walikelas          String?
  isProfileComplete  Boolean     @default(false)
  userId             String      @unique

  kelas              Kelas[]     // satu guru bisa punya banyak kelas
  mataPelajaran     MataPelajaran[] // satu guru bisa mengajar banyak mata pelajaran
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Jadwal          Jadwal[]     // satu guru bisa punya banyak jadwal
  
  // New relations for attendance and assessment
  absensi            Absensi[]   // Attendance records created by this teacher
  penilaian          Penilaian[] // Assessments created by this teacher
  @@map("guru")
}

model Kalender {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tanggalMulai  DateTime
  tanggalSelesai DateTime?
  semester      String   @default("1")
  keterangan    String?

  @@map("kalender")
}

model MataPelajaran {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  nama        String
  kode        String?  @unique
  deskripsi   String?
  guru        Guru?    @relation(fields: [guruId], references: [id])
  guruId      String?
  KKM         KKM[]     // satu mata pelajaran bisa punya banyak KKM
  Jadwal     Jadwal[]  // satu mata pelajaran bisa punya banyak jadwal
  penilaian   Penilaian[] // assessments for this subject
  @@map("mata_pelajaran")
}

model KKM {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  MataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])
  mataPelajaranId String
  nilai       Int

  @@map("kkm")
}
model Jadwal {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  hari          Hari         // enum hari: SENIN, SELASA, dll
  jamMulai      String       // contoh: "08:00"
  jamSelesai    String       // contoh: "09:30"

  kelasId       String
  kelas         Kelas        @relation(fields: [kelasId], references: [id])

  guruId        String
  guru          Guru         @relation(fields: [guruId], references: [id])

  mataPelajaranId String?
  mataPelajaran   MataPelajaran? @relation(fields: [mataPelajaranId], references: [id])

  @@map("jadwal")
}

model Beasiswa {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  nama         String
  deskripsi    String?
  nominal      Float
  mulaiBerlaku DateTime?
  selesaiBerlaku DateTime?
  status       StatusBeasiswa @default(AKTIF)

  siswaId      String
  siswa        Siswa      @relation(fields: [siswaId], references: [id])

  @@map("beasiswa")
}

enum StatusBeasiswa {
  AKTIF
  NONAKTIF
  SELESAI
}
model Pembayaran {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tipe         TipePembayaran
  jumlah       Float
  tanggal      DateTime
  status       StatusPembayaran @default(BELUM_BAYAR)
  metode       MetodePembayaran?

  siswaId      String
  siswa        Siswa      @relation(fields: [siswaId], references: [id])

  kelasId      String?
  kelas        Kelas?     @relation(fields: [kelasId], references: [id])

  @@map("pembayaran")
}

enum TipePembayaran {
  SPP
  BUKU
  EKSKUL
  LAINNYA
}

enum StatusPembayaran {
  BELUM_BAYAR
  SUDAH_BAYAR
  TERTUNDA
}

enum MetodePembayaran {
  CASH
  TRANSFER
  VIRTUAL_ACCOUNT
  E_WALLET
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

model Kelas {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Class Identity
  namaKelas   String   // e.g., "7A", "8B", "10 IPA 1", "11 IPS 2", "12E"
  
  // Academic Period
  tahunAjaran String   // Academic year: "2024/2025"
  semester    String   // Current semester: "1" or "2"
  
  // Program and School Level
  jenjang     Jenjang  // Education level: SMP or SMA
  jurusan     String?  // Program: "IPA", "IPS", "Bahasa" (for SMA only)
  
  // Status
  isActive    Boolean  @default(true) // Is this class currently active
  
  // Teacher Assignment
  guru        Guru?    @relation(fields: [guruId], references: [id])
  guruId      String?

  // Relations
  siswa       Siswa[]  @relation("KelasSiswa") // Students in this class
  Jadwal     Jadwal[]  // Class schedules
  Pembayaran Pembayaran[] // Class-related payments
  
  // New relations for attendance and assessment
  absensi     Absensi[]   // Attendance records for this class
  penilaian   Penilaian[] // Assessments for this class
  
  // Ensure unique class per academic year
  @@unique([namaKelas, tahunAjaran])
  @@map("kelas")
}

model Siswa {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Basic Information
  namaLengkap       String
  nisn              String?   @unique
  nik               String?   @unique
  tempatLahir       String?
  tanggalLahir      DateTime?
  jenisKelamin      Gender?
  agama             Agama?
  
  // Contact Information
  noHp              String?
  emailAlternatif   String?
  alamatLengkap     String?
  kelurahan         String?
  kecamatan         String?
  kabupatenKota     String?
  provinsi          String?
  kodePos           String?
  
  // Academic Information
  tahunMasuk        Int?      // Year first enrolled
  
  // Student Status and Graduation Tracking
  status            StatusSiswa @default(AKTIF)
  tahunLulus        Int?        // Year of graduation
  tanggalLulus      DateTime?   // Exact graduation date
  alasanKeluar      String?     // Reason for leaving (if not graduated)
  
  // Family Information
  namaAyah          String?
  namaIbu           String?
  namaWali          String?
  pekerjaanAyah     String?
  pekerjaanIbu      String?
  pekerjaanWali     String?
  noHpOrtu          String?
  
  // System Fields
  statsuSiswa      String?   // Legacy field, consider removing
  isProfileComplete Boolean   @default(false)
  userId            String    @unique
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Beasiswa     Beasiswa[] // satu siswa bisa punya banyak beasiswa
  kelas             Kelas[]   @relation("KelasSiswa") // Class history (many-to-many)
  Pembayaran     Pembayaran[] // satu siswa bisa punya banyak pembayaran
  
  // New relations for attendance and assessment
  absensi           Absensi[]     // Attendance records for this student
  nilaiSiswa        NilaiSiswa[]  // Assessment scores for this student
  
  @@map("siswa")
}


model Session {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  identifier String
  value      String
  expiresAt  DateTime

  @@map("verifications")
}

enum UserRole {
  ADMIN
  GURU
  SISWA
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
}

enum StatusKawin {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum StatusSiswa {
  AKTIF          // Currently enrolled and active
  LULUS          // Graduated successfully
  PINDAH         // Transferred to another school
  KELUAR         // Dropped out
  DIKELUARKAN    // Expelled
  CUTI           // On leave/hiatus
}

enum Jenjang {
  SMP            // Sekolah Menengah Pertama (Junior High)
  SMA            // Sekolah Menengah Atas (Senior High)
  SMK            // Sekolah Menengah Kejuruan (Vocational High)
}


model UserLog {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  userId    String?   // nullable karena bisa ada aktivitas tanpa user (guest)
  action    String    // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, VIEW
  resource  String?   // nama resource yang diakses (posts, users, guru, siswa)
  details   String?   // detail tambahan dalam format JSON string
  ipAddress String?   
  userAgent String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("user_logs")
}

// ATTENDANCE SYSTEM (ABSENSI)
// UI Form: Month selector, Class (taught by teacher), Student names with radio buttons
model Absensi {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Time Period
  bulan       Int          // Month (1-12) for UI month selector
  tahun       Int          // Year
  tanggal     DateTime     // Specific date of attendance
  
  // Radio Button Options: Hadir, Sakit, Izin, Alfa
  status      StatusAbsensi @default(HADIR)
  keterangan  String?      // Required for SAKIT and IZIN
  
  // Relations
  siswaId     String
  siswa       Siswa        @relation(fields: [siswaId], references: [id])
  
  kelasId     String       // Class being taught
  kelas       Kelas        @relation(fields: [kelasId], references: [id])
  
  guruId      String       // Teacher teaching this class
  guru        Guru         @relation(fields: [guruId], references: [id])
  
  // Prevent duplicate attendance per student per day
  @@unique([siswaId, kelasId, tanggal])
  @@map("absensi")
}

// ASSESSMENT SYSTEM (PENILAIAN)
// Categories: Umum, UTS, UAS, Ulangan Harian (no enums, just string)
model Penilaian {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Assessment Info
  nama             String    // Assessment name
  kategori         String    // "Umum", "UTS", "UAS", "Ulangan Harian"
  tanggalPenilaian DateTime  // Assessment date
  nilaiMaksimal    Float     @default(100)
  deskripsi        String?   // Optional description for the assessment
  
  // Relations
  kelasId          String    // Class being assessed
  kelas            Kelas     @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  
  guruId           String    // Teacher creating assessment
  guru             Guru      @relation(fields: [guruId], references: [id], onDelete: Cascade)
  
  mataPelajaranId  String    // Subject being assessed
  mataPelajaran    MataPelajaran @relation(fields: [mataPelajaranId], references: [id], onDelete: Cascade)
  
  // Student scores for this assessment
  nilaiSiswa       NilaiSiswa[]
  
  @@map("penilaian")
}

// Individual student scores
model NilaiSiswa {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  nilai        Float      // Numeric score
  catatan      String?    // Optional notes for this student's score
  
  // Relations
  siswaId      String
  siswa        Siswa      @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  
  penilaianId  String
  penilaian    Penilaian  @relation(fields: [penilaianId], references: [id], onDelete: Cascade)
  
  // One score per student per assessment
  @@unique([siswaId, penilaianId])
  @@map("nilai_siswa")
}

// ATTENDANCE STATUS ENUM
enum StatusAbsensi {
  HADIR    // Present - radio button option
  SAKIT    // Sick - radio button option (requires keterangan)
  IZIN     // Permission - radio button option (requires keterangan)
  ALFA     // Absent - radio button option
}